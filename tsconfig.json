{
  "compilerOptions": {
    "target": "ES2020", // Современный JS
    "module": "NodeNext", // Для Node.js (или "CommonJS" для старых версий)
    "moduleResolution": "NodeNext", // Как разрешать модули
    "rootDir": "./src", // Исходная папка с TS
    "outDir": "./dist", // Куда складывать JS
    "strict": true, // Строгая проверка типов
    "esModuleInterop": true, // Для совместимости с CommonJS/ESM
    "skipLibCheck": true, // Ускоряет компиляцию
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
